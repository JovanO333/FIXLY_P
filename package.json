{
  "name": "fixly-plan-de-pruebas",
  "version": "1.0.0",
  "description": "Pruebas unitarias, de integracion (API) y E2E del Plan de Pruebas",
  "scripts": {
    "test:unit": "jest --verbose",
    "test:unit:report": "jest --coverage --json --outputFile=evidencias/resultado-unitarias.json",
    "test:api": "newman run postman/api-tests.postman_collection.json -r cli,htmlextra --reporter-htmlextra-export evidencias/reporte-api.html",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "cypress": "^13.15.0",
    "@badeball/cypress-cucumber-preprocessor": "^20.1.2",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.3",
    "esbuild": "^0.23.1",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}